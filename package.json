{
  "main": "public/electron.js",
  "name": "mon-projet-react",
  "version": "1.0.1",
  "private": true,
  "dependencies": {
    "cra-template": "1.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "dist": "npx electron-builder --win --publish always",
    "electron": "npx electron ."
  },
  "build": {
    "appId": "com.monsite.application",
    "productName": "MonApp",
    "win": {
      "target": "nsis",
      "publish": [
        {
          "provider": "github",
          "owner": "Nampiana",
          "repo": "auto-update-electron"
        }
      ]
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^34.1.1",
    "electron-builder": "^25.1.8",
    "web-vitals": "^4.2.4"
  }
}
